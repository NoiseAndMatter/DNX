{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2022"],
    "types": []
  },
  // The platform-free core, checked with no DOM and no Node. The only host globals it may use are
  // declared in types/core-host.d.ts. `test/layers.test.ts` checks the same boundary from the
  // import side.
  //
  // **A whole package, with nothing excluded.** This used to point at `src/**` and then subtract
  // the folders that were not core — first three directories, later two more and four files by
  // name. The package boundary replaces the subtraction: everything under `packages/core` is core
  // because that is what the directory is, and a file that does not belong is in the wrong repo
  // folder rather than missing from a list.
  "include": [
    "types/core-host.d.ts",
    "packages/core/src/**/*.ts"
  ]
}
