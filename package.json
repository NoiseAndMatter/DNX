{
  "name": "dnx",
  "version": "0.1.0",
  "description": "Read, write and convert Elektron Digitone and Digitone II project files, and talk to the instruments over WebMIDI",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angellinares/DNX.git"
  },
  "type": "module",
  "scripts": {
    "inspect": "tsx src/cli/inspect.ts",
    "diff": "tsx src/cli/diff.ts",
    "test": "tsx --test test/*.test.ts",
    "test:nocorpus": "tsx test/nocorpus.ts",
    "verify": "npm test && npm run test:nocorpus && npm run typecheck && tsc -p tsconfig.web.json --noEmit",
    "typecheck": "tsc --noEmit",
    "project": "tsx src/cli/project.ts",
    "plan": "tsx src/cli/plan.ts",
    "copy": "tsx src/cli/copy.ts",
    "rearrange": "tsx src/cli/rearrange.ts",
    "track": "tsx src/cli/track.ts",
    "rename": "tsx src/cli/rename.ts",
    "rebuild": "tsx src/cli/rebuild.ts",
    "usbcap": "tsx src/cli/usbcap.ts",
    "extract-blank": "tsx src/cli/extractblank.ts",
    "extract-blank-project": "tsx src/cli/extractblankproject.ts",
    "hwtest": "tsx src/cli/hardwaretest.ts",
    "trackhwtest": "tsx src/cli/trackhwtest.ts",
    "tags": "tsx src/cli/tags.ts",
    "convert": "tsx src/cli/convert.ts",
    "sheet": "tsx src/cli/sheet.ts",
    "build:web": "tsc -p tsconfig.web.json",
    "web": "npm run build:web && tsx src/cli/serve.ts",
    "projectdiff": "tsx src/cli/projectdiff.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  }
}
